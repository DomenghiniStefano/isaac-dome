          "ordered": false,
          "items": [
            {
              "inline": [
                {
                  "kind": "text",
                  "text": "Upon entering a new room, Isaac will become camouflaged and all enemies become ",
                  "style": "plain"
                },
                {
                  "kind": "concept",
                  "page": "confusion",
                  "label": "confused"
                },
                {
                  "kind": "text",
                  "text": ". The effect will last until Isaac presses a fire button.",
                  "style": "plain"
                }
              ],
              "children": [
                {
                  "kind": "list",
                  "ordered": false,
                  "items": [
                    {
                      "inline": [
                        {
                          "kind": "text",
                          "text": "Bosses will not be confused when Isaac is camouflaged.",
                          "style": "plain"
                        }
                      ],
                      "children": []
                    },
                    {
                      "inline": [
                        {
                          "kind": "edition",
                          "only": [
                            "repentance"
                          ],
                          "inline": [
                            {
                              "kind": "text",
                              "text": " While camouflaged, Isaac gains +0.5 ",
                              "style": "plain"
                            },
                            {
                              "kind": "concept",
                              "page": "Speed",
                              "label": "Speed"
                            },
                            {
                              "kind": "text",
                              "text": ". When the camouflage is dropped, enemies in a short radius around Isaac take 15 damage, and he gains a temporary +10.5 ",
                              "style": "plain"
                            },
                            {
                              "kind": "concept",
                              "page": "Damage",
                              "label": "Damage"
                            },
                            {
                              "kind": "text",
                              "text": " and +7.5 ",
                              "style": "plain"
                            },
                            {
                              "kind": "concept",
                              "page": "Tears",
                              "label": "Tears"
                            },
                            {
                              "kind": "text",
                              "text": " up which both rapidly scale down to 0. The tears up ignores the soft tears cap.",
                              "style": "plain"
                            }
                          ]
                        }
                      ],
                      "children": [
                        {
                          "kind": "list",
                          "ordered": false,
                          "items": [
                            {
                              "inline": [
                                {
                                  "kind": "text",
                                  "text": "If Isaac is firing tears while walking into a room, the camouflage and stat boost will not apply.",
                                  "style": "plain"
                                }
                              ],
                              "children": [
                                {
                                  "kind": "list",
                                  "ordered": false,
                                  "items": [
                                    {
                                      "inline": [
                                        {
                                          "kind": "text",
                                          "text": "This also applies when pressing a fire button to skip boss transition cutscenes.",
                                          "style": "plain"
                                        }
                                      ],
                                      "children": []
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
