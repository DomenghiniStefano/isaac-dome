                }
              ],
              "children": [
                {
                  "kind": "list",
                  "ordered": false,
                  "items": [
                    {
                      "inline": [
                        {
                          "kind": "edition",
                          "only": [],
                          "inline": [
                            {
                              "kind": "text",
                              "text": " The passive Tonsil item does not exist in any item pool; thus, this is the only way to find it and make it appear in the ",
                              "style": "plain"
                            },
                            {
                              "kind": "concept",
                              "page": "Collection Page (Afterbirth †)",
                              "label": "Collection Page"
                            },
                            {
                              "kind": "text",
                              "text": " aside from starting with it as ",
                              "style": "plain"
                            },
                            {
                              "kind": "ref",
                              "target": {
                                "kind": "character",
                                "id": 9
                              },
                              "label": "Eden"
                            },
                            {
                              "kind": "text",
                              "text": ".",
                              "style": "plain"
                            }
                          ]
                        }
                      ],
                      "children": [
                        {
                          "kind": "list",
                          "ordered": false,
                          "items": [
                            {
                              "inline": [
                                {
                                  "kind": "edition",
                                  "only": [],
                                  "inline": [
                                    {
                                      "kind": "text",
                                      "text": " If Eden starts with the passive tonsil item and picks up the trinket, the trinket will spawn only one familiar before being consumed.",
                                      "style": "plain"
                                    }
                                  ]
                                }
                              ],
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "inline": [
                {
                  "kind": "text",
                  "text": "Sources of self-inflicted damage, like ",
                  "style": "plain"
                },
                {
                  "kind": "ref",
                  "target": {
                    "kind": "item",
                    "id": 135
                  },
                  "label": "IV Bag"
                },
                {
                  "kind": "text",
                  "text": " or Blood Donation Machines, can spawn a familiar.",
                  "style": "plain"
                }
              ],
              "children": []
            },
            {
              "inline": [
                {
                  "kind": "text",
                  "text": "Damage that is blocked by ",
                  "style": "plain"
                },
                {
                  "kind": "ref",
                  "target": {
                    "kind": "item",
                    "id": 313
                  },
                  "label": "Holy Mantle"
                },
                {
                  "kind": "text",
                  "text": " or the ",
                  "style": "plain"
                },
                {
                  "kind": "ref",
                  "target": {
                    "kind": "pickup",
                    "name": "Holy Card"
                  },
                  "label": "Holy Card"
                },
                {
                  "kind": "text",
                  "text": " does not count to the number of hits that are needed for the tonsil familiar to spawn.",
                  "style": "plain"
                }
              ],
              "children": []
            },
