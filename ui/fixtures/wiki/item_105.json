          "items": [
            {
              "inline": [
                {
                  "kind": "edition",
                  "only": [],
                  "inline": [
                    {
                      "kind": "text",
                      "text": " The D6 is a ",
                      "style": "plain"
                    },
                    {
                      "kind": "concept",
                      "page": "special item",
                      "label": "special item"
                    },
                    {
                      "kind": "text",
                      "text": ".",
                      "style": "plain"
                    }
                  ]
