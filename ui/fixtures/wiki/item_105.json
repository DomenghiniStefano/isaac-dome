                  "page": "pickups",
                  "label": "pickups"
                },
                {
                  "kind": "text",
                  "text": " or ",
                  "style": "plain"
                },
                {
                  "kind": "concept",
                  "page": "trinkets",
                  "label": "trinkets"
                },
                {
                  "kind": "text",
                  "text": ") with other random items corresponding to the current room's ",
                  "style": "plain"
                },
                {
                  "kind": "concept",
                  "page": "item pool",
                  "label": "item pool"
                },
                {
                  "kind": "text",
                  "text": ".",
