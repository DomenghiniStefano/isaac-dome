 | name        = Eggy
 | id          = 29
 | variant     = 2
 | base hp     = 20
 | stage hp    = 2
 | environment = {{floor|Catacombs}}<br>{{Floor|Necropolis}}<br>{{floor|Utero}}<br>{{floor|Corpse}}<br>{{room|challenge}}
