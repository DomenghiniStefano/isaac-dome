{{infobox monster
 | id          = 29
 | base hp     = 10
 | environment = {{floor|Basement}}{{floor|Cellar}}{{floor|Burning Basement}}<br>{{floor|Caves}}{{floor|Catacombs}}{{floor|Flooded Caves}}<br>{{floor|Depths}}{{floor|Dank Depths}}<br>{{room|boss}}{{room|challenge}}
 | behavior    = Slowly hops around the room, doing contact damage. Can turn into a Flaming Hopper by jumping into {{E|Fire Place}}s or other fires.
