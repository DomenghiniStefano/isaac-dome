 | base hp        = 14
 | environment    = {{floor|Downpour}}{{floor|Dross}}<br>{{room|challenge}}
 | replace        = Horf
 | replace chance = 1.67%
 | behavior       = Stationary enemy that spins and fires shots while being moved around or knocked back.
