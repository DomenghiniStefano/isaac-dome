{{function
 | name     = GetName()
 | syntax   = Player:GetName()
 | desc     = Gets the name of the player.
 | rets     = {{functionRet | type = String | name = Name | desc = A string that represents the name of the character you are playing as. }}
 | examples = {{functionExample | number = 1 | desc = Prints out the name of the character in the debug console. | code =
<pre style="background: #4a3026">
player = Isaac.GetPlayer( 0 )
Isaac.DebugString( player:GetName() )
</pre> }}
}}
{{function
 | name     = AddNullCostume()
 | syntax   = Player:AddNullCostume( Config::NullItemID NullId )
 | desc     = Adds a costume to the player.
 | args     = {{functionArg | type = integer | name = CostumeID | desc = The id of the costume to add. }}
 | examples = {{functionExample | number = 1 | desc = Adds a custom made costume to the player upon picking up the item. | code =
<pre style="background: #4a3026">
local costume = {}
local custom_costume = Isaac.GetCostumeIdByPath( "gfx/characters/costume.anm2" )
function afterlife:playerFrameUpdate( _player )
  if game:GetFrameCount() == 1 then
    setCostume( custom_costume, false )
  end
  if not hasCostume( markOfCain_costume ) and _player:HasCollectible( markOfCain_item ) then
    _player:AddNullCostume( custom_costume )
    setCostume( custom_costume, true )
  end
end

function hasCostume( _costume )
  if costume[_costume] ~= nil then
    return costume[_costume]
  else
    return false
  end
end

function setCostume( _costume, _value )
  costume[_costume] = _value
end

afterlife:AddCallback( ModCallbacks.MC_POST_PEFFECT_UPDATE, afterlife.playerFrameUpdate )
</pre> }}
}}

