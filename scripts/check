#!/bin/sh
# Every check in the project, in a single command.
#
# There's no CI: this is the list, and it lives here and nowhere else. The README, the
# pre-commit hook, and CLAUDE.md all point to this file instead of repeating the
# commands, so they can't drift apart. Run it from the repo root, also as `pnpm check`.
#
# It doesn't stop at the first failure: it runs everything and summarizes at the end.
# Knowing that three different things failed changes what you do next; finding them
# out one at a time doesn't.

set -u
cd "$(dirname "$0")/.." || exit 1

failed=''
run() {
	name=$1
	shift
	printf '\n=== %s\n' "$name"
	if "$@"; then
		return 0
	fi
	failed="$failed $name"
	return 1
}

output=$(mktemp)
ui_output=$(mktemp)
declarations=$(mktemp)
# The scratch lives under `ui/` and not in the system temp on purpose: prettier resolves its
# configuration by walking up from the file, so a copy anywhere else is formatted by other
# rules and reads as stale. On Windows it also never sees an MSYS `/tmp` path.
types_scratch=ui/.ipc-types-check
trap 'rm -f "$output" "$ui_output" "$declarations"; rm -rf "$types_scratch"' EXIT

run 'cargo fmt' cargo fmt --check
run 'cargo clippy' cargo clippy --all-targets -- -D warnings

# `--nocapture` isn't a whim: without it, the test harness **hides** the output of
# passing tests, so the `skip:` and `sample:` lines don't show up and an "N passed"
# doesn't say how many tests were skipped for lack of data. It's the exact way
# `unpack` stayed broken for days (D3 in docs/IMPROVEMENTS.md). The output is also kept
# in a file so it can be counted below.
printf '\n=== cargo test\n'
# The declarations are counted from their own file, not from this output. The harness
# writes `test … ok` to stdout while `test-support` declares on stderr, and merging the
# two here can split a line down the middle (`skip: ok`, with the rest orphaned); tests
# inside one binary interleave with each other too. A summary whose job is to say how
# much a run *didn't* verify has to be exact, so `test-support` mirrors every line into
# ISAACDOME_TEST_DECLARATIONS, one atomic append each.
ISAACDOME_TEST_DECLARATIONS="$declarations" cargo test --workspace -- --nocapture >"$output" 2>&1
if [ $? -ne 0 ]; then
	failed="$failed cargo-test"
fi
cat "$output"

run 'pnpm typecheck' pnpm typecheck

# Kept in a file for the same reason `cargo test`'s output is: the totals are counted below, and
# the frontend suite is exactly as deletable as the Rust one — 82 files of it (B63).
printf '\n=== pnpm ui:test\n'
pnpm ui:test >"$ui_output" 2>&1
if [ $? -ne 0 ]; then
	failed="$failed pnpm-ui:test"
fi
cat "$ui_output"

run 'pnpm lint' pnpm lint
run 'pnpm format:check' pnpm format:check
run 'pnpm scan' pnpm scan

# **A gate, unlike the document report below.** No picture, sound or game archive is tracked
# outside the app's own icons: CLAUDE.md's third promise is that the images come from the
# user's own copy at runtime, and for two weeks that promise was false without anything
# noticing. See the comment at the top of the script.
run 'no game assets' node scripts/check-no-game-assets.mjs

# **A gate too, for the same reason.** No Steam account id is tracked beyond the declared fakes:
# the owner's sat in a probe path and a test fixture for three weeks and left the history on
# 2026-09-24 (card #83). The script never names the real one.
run 'no steam account id' node scripts/check-no-steam-account-id.mjs

# **Fewer tests than where the branch started fails** (B63). Declarations counted by `git grep` in
# the working tree and at the merge base with `develop`, so there is no stored number to raise
# and nothing for two branches to conflict on — which is what the file it replaced,
# `scripts/test-floor`, did on every parallel merge (card #84). The comment at the top of the
# script says what it counts and what it cannot see.
run 'test count' node scripts/check-test-count.mjs

# The contract is generated (N7, B2 in docs/IMPROVEMENTS.md): this is what makes a Rust type
# and its TypeScript disagree loudly instead of silently. It regenerates into a scratch copy
# and compares — it never writes the real file, because a check that repairs what it is
# checking cannot report on it.
printf '\n=== ipc types\n'
mkdir -p "$types_scratch"
if ISAACDOME_TYPES_OUT="$types_scratch/types.ts" cargo run -q -p ipc --bin ipc-types >/dev/null &&
	pnpm --filter ui exec prettier --write .ipc-types-check/types.ts >/dev/null 2>&1 &&
	diff -u ui/src/lib/ipc/types.ts "$types_scratch/types.ts"; then
	printf 'types.ts matches the Rust types\n'
else
	printf 'types.ts is stale: run `pnpm ipc:types`\n'
	failed="$failed ipc-types"
fi
rm -rf "$types_scratch"

# Every file path the living documents name, against the files git tracks. **A report, not a
# gate**: it cannot tell a name written as history from one written as a promise, so it prints
# and never fails. Added 2026-09-15, after the same defect turned up in every document in the
# repo — `frontend-conventions` had been citing a deleted test as the thing pinning a row
# height, and three open backlog entries pointed at files a refactor had renamed under them.
printf '\n=== doc references\n'
node scripts/check-doc-refs.mjs || printf 'the reference report could not run\n'

skipped=$(grep -c '^skip:' "$declarations")
real_files=$(grep -c '^sample:' "$declarations")

# **How many tests ran**, printed and never judged: the judgment is `test count` above, on the
# declarations. Passed plus failed plus ignored on the Rust side, so a test the harness stopped
# running still shows here.
rust_tests=$(awk '/^test result:/ {
	for (i = 1; i <= NF; i++)
		if ($i == "passed;" || $i == "failed;" || $i == "ignored;") s += $(i - 1)
} END { print s + 0 }' "$output")
# Vitest's own total, in the parentheses: `Tests  591 passed (591)`. The parenthesised number
# counts the skipped ones too, which is the number this is about.
ui_tests=$(awk '/Tests +[0-9]/ { n = $NF; gsub(/[()]/, "", n); t = n } END { print t + 0 }' "$ui_output")

printf '\n=== summary\n'
printf 'tests skipped (sample or missing tool): %s\n' "$skipped"
printf 'real files touched: %s\n' "$real_files"
[ "$skipped" -gt 0 ] && grep '^skip:' "$declarations" | sort | uniq -c | sed 's/^/  /'
printf 'tests that ran: %s rust, %s ui\n' "$rust_tests" "$ui_tests"

if [ -n "$failed" ]; then
	printf '\nFAILED:%s\n' "$failed"
	exit 1
fi
printf '\nall green\n'
