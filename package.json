{
  "name": "isaac-dome",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "check": "sh scripts/check",
    "dev": "tauri dev --config crates/app/tauri.conf.json",
    "build": "tauri build --config crates/app/tauri.conf.json",
    "ui:dev": "pnpm --filter ui dev",
    "ui:test": "pnpm --filter ui test",
    "lint": "pnpm --filter ui lint",
    "typecheck": "pnpm --filter ui typecheck",
    "scan": "pnpm --filter ui scan",
    "format:check": "pnpm --filter ui format:check",
    "wiki:fetch": "cargo run -q -p wiki-snapshot -- fetch",
    "wiki:build": "cargo run -q -p wiki-snapshot -- build",
    "graph:rules": "cargo run -q -p graph --bin graph-rules",
    "ipc:types": "cargo run -q -p ipc --bin ipc-types && pnpm --filter ui exec prettier --write src/lib/ipc/types.ts",
    "design:export": "cargo run -q -p design-export"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.4.1"
}
