{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IsaacDome",
  "version": "../../package.json",
  "identifier": "dev.isaacdome.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "IsaacDome",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#150e0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' isaac: http://isaac.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' isaac: http://isaac.localhost data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGMjc0QkU3NkJDMzU3NUMKUldSY1Y4TnI1MHNuLzgwQkJmZEc0VU96T0FNK21yS0lVWVI5SkdiMUZ5QUFOK1pFem12cmp1ZmMK",
      "endpoints": [
        "https://github.com/DomenghiniStefano/isaac-dome/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (C) 2026 Stefano Domenghini",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../ui/src/assets/fonts/determination/license.txt": "licenses/determination/license.txt",
      "../../ui/src/assets/fonts/determination/readme.txt": "licenses/determination/readme.txt",
      "../../dataset/ATTRIBUTION.md": "licenses/wiki/ATTRIBUTION.md"
    }
  }
}
